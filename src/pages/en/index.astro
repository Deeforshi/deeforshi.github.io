---
import { getCollection } from 'astro:content';
import type { Locale } from '../../i18n/ui';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import AboutTimeline from '../../components/AboutTimeline.astro';
import Skills from '../../components/Skills.astro';
import ProjectsSection from '../../components/ProjectsSection.astro';
import CvSection from '../../components/CvSection.astro';
import ContactSection from '../../components/ContactSection.astro';

const locale: Locale = 'en';
const alternateUrl = '/';

const projects = (
  await getCollection('projects', ({ data }) => data.locale === locale)
).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  locale={locale}
  title="Heddy Brun (Deeforshi) — Data, Agentic AI & Automation Developer"
  description="Portfolio of Heddy Brun (Deeforshi): Data & AI apprentice at Prospilot, MAALSI Master's student at CESI Bordeaux, n8n workflows and full-stack software engineering."
  alternateUrl={alternateUrl}
>
  <Hero locale={locale} />
  <AboutTimeline locale={locale} />
  <Skills locale={locale} />
  <ProjectsSection locale={locale} projects={projects} />
  <CvSection locale={locale} />
  <ContactSection locale={locale} />
</BaseLayout>
