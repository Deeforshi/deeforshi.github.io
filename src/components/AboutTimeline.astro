---
import { ui, type Locale } from '../i18n/ui';
import { siteConfig } from '../data/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const isFr = locale === 'fr';
const aboutText = ui[locale].about;
const bioParagraphs = siteConfig.bio[locale];
const languages = siteConfig.languages;
const softSkills = siteConfig.softSkills[locale];
const hobbies = siteConfig.hobbies[locale];
const timelineItems = siteConfig.timeline;
---

<section id="about" class="relative py-20 border-t border-[#00f0ff]/10">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <!-- Section Heading -->
    <div class="mb-12 flex flex-col gap-2">
      <span class="font-mono text-xs uppercase tracking-[0.22em] text-[#00f0ff]">
        {aboutText.tag}
      </span>
      <h2 class="font-display text-3xl sm:text-4xl font-bold tracking-tight text-white">
        {aboutText.title}
      </h2>
      <p class="max-w-2xl text-sm sm:text-base text-slate-400">
        {aboutText.subtitle}
      </p>
    </div>

    <!-- Top Grid: Bio + Compact HUD Cards -->
    <div class="grid gap-6 lg:grid-cols-12">
      <!-- Bio Card -->
      <div class="clip-cyber lg:col-span-7 border border-[#00f0ff]/25 bg-[#0d101d]/90 p-6 sm:p-8 transition-colors hover:border-[#00f0ff]/55">
        <div class="mb-4 flex items-center justify-between font-mono text-xs text-[#00f0ff]">
          <span>&gt;_ {aboutText.bioTitle.toUpperCase()}</span>
          <span class="text-slate-500">UTF-8 // {locale.toUpperCase()}</span>
        </div>
        <div class="space-y-4 text-base leading-relaxed text-slate-200">
          {bioParagraphs.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </div>
      </div>

      <!-- Compact HUD Cards -->
      <div class="lg:col-span-5 grid gap-4">
        <!-- Languages -->
        <div class="clip-cyber-sm border border-[#00f0ff]/25 bg-[#0d101d]/90 p-5 transition-colors hover:border-[#00f0ff]/55">
          <h3 class="mb-3 font-mono text-xs font-bold uppercase tracking-widest text-[#00f0ff]">
            // {aboutText.languagesTitle}
          </h3>
          <div class="flex flex-wrap gap-2">
            {languages.map((lang) => (
              <div class="inline-flex items-center gap-2 border border-slate-700/80 bg-[#12172a] px-3 py-1.5 font-mono text-xs">
                <span class="font-semibold text-white">{lang.name[locale]}</span>
                <span class="text-[#00f0ff]">{lang.level[locale]}</span>
              </div>
            ))}
          </div>
        </div>

        <!-- Soft Skills -->
        <div class="clip-cyber-sm border border-[#ff2a85]/25 bg-[#0d101d]/90 p-5 transition-colors hover:border-[#ff2a85]/55">
          <h3 class="mb-3 font-mono text-xs font-bold uppercase tracking-widest text-[#ff2a85]">
            // {aboutText.softSkillsTitle}
          </h3>
          <div class="flex flex-wrap gap-2">
            {softSkills.map((skill) => (
              <span class="border border-[#ff2a85]/30 bg-[#ff2a85]/10 px-2.5 py-1 font-mono text-xs text-slate-200">
                {skill}
              </span>
            ))}
          </div>
        </div>

        <!-- Hobbies -->
        <div class="clip-cyber-sm border border-[#9d4edd]/25 bg-[#0d101d]/90 p-5 transition-colors hover:border-[#9d4edd]/55">
          <h3 class="mb-3 font-mono text-xs font-bold uppercase tracking-widest text-[#9d4edd]">
            // {aboutText.hobbiesTitle}
          </h3>
          <div class="flex flex-wrap gap-2">
            {hobbies.map((hobby) => (
              <span class="border border-[#9d4edd]/30 bg-[#9d4edd]/10 px-2.5 py-1 font-mono text-xs text-slate-200">
                {hobby}
              </span>
            ))}
          </div>
        </div>
      </div>
    </div>

    <!-- Interactive Timeline -->
    <div class="mt-14">
      <div class="mb-8 flex flex-wrap items-center justify-between gap-4">
        <h3 class="font-display text-2xl font-bold text-white">
          {aboutText.timelineTitle}
        </h3>

        <!-- Filter Tabs -->
        <div role="tablist" aria-label={isFr ? 'Filtrer le parcours' : 'Filter timeline'} class="inline-flex flex-wrap gap-2">
          <button
            type="button"
            role="tab"
            aria-selected="true"
            data-timeline-filter="all"
            class="timeline-tab clip-cyber-sm border border-[#00f0ff] bg-[#00f0ff]/15 px-4 py-1.5 font-mono text-xs font-semibold uppercase tracking-wider text-[#00f0ff] transition-all cursor-pointer"
          >
            {isFr ? 'Tout' : 'All'}
          </button>
          <button
            type="button"
            role="tab"
            aria-selected="false"
            data-timeline-filter="experience"
            class="timeline-tab clip-cyber-sm border border-slate-700 bg-[#0d101d] px-4 py-1.5 font-mono text-xs font-semibold uppercase tracking-wider text-slate-300 transition-all hover:border-[#00f0ff]/50 hover:text-white cursor-pointer"
          >
            {aboutText.expTab}
          </button>
          <button
            type="button"
            role="tab"
            aria-selected="false"
            data-timeline-filter="education"
            class="timeline-tab clip-cyber-sm border border-slate-700 bg-[#0d101d] px-4 py-1.5 font-mono text-xs font-semibold uppercase tracking-wider text-slate-300 transition-all hover:border-[#00f0ff]/50 hover:text-white cursor-pointer"
          >
            {aboutText.eduTab}
          </button>
        </div>
      </div>

      <!-- Vertical Neon Timeline -->
      <div class="relative pl-6 sm:pl-8 space-y-6">
        <!-- Glowing vertical line -->
        <div
          aria-hidden="true"
          class="absolute top-2 bottom-2 left-[9px] sm:left-[11px] w-[2px] bg-gradient-to-b from-[#00f0ff] via-[#9d4edd] to-[#ff2a85] shadow-[0_0_10px_rgba(0,240,255,0.45)]"
        ></div>

        {timelineItems.map((item) => {
          const isExp = item.type === 'experience';
          return (
            <article
              data-timeline-item
              data-type={item.type}
              class="relative"
            >
              <!-- Node dot -->
              <span
                aria-hidden="true"
                class:list={[
                  'absolute -left-6 sm:-left-8 top-6 flex h-5 w-5 items-center justify-center rounded-full border-2 bg-[#07080f]',
                  item.current
                    ? 'border-[#00f0ff] shadow-[0_0_12px_#00f0ff]'
                    : isExp
                      ? 'border-[#00f0ff]/70'
                      : 'border-[#ff2a85]/70',
                ]}
              >
                {item.current ? (
                  <span class="relative flex h-2.5 w-2.5">
                    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#00f0ff] opacity-80"></span>
                    <span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-[#00f0ff]"></span>
                  </span>
                ) : (
                  <span class:list={['h-2 w-2 rounded-full', isExp ? 'bg-[#00f0ff]' : 'bg-[#ff2a85]']}></span>
                )}
              </span>

              <!-- Card -->
              <div class="clip-cyber border border-slate-800 bg-[#0d101d]/90 p-5 sm:p-6 transition-all hover:border-[#00f0ff]/50 hover:bg-[#12172a]/90">
                <div class="flex flex-wrap items-start justify-between gap-2">
                  <div>
                    <div class="flex flex-wrap items-center gap-2.5">
                      <span
                        class:list={[
                          'font-mono text-[11px] font-bold uppercase tracking-wider px-2 py-0.5 border',
                          isExp
                            ? 'border-[#00f0ff]/40 bg-[#00f0ff]/10 text-[#00f0ff]'
                            : 'border-[#ff2a85]/40 bg-[#ff2a85]/10 text-[#ff2a85]',
                        ]}
                      >
                        {isExp ? aboutText.expTab : aboutText.eduTab}
                      </span>

                      {item.current && (
                        <span class="inline-flex items-center gap-1.5 border border-[#00f0ff]/50 bg-[#00f0ff]/15 px-2 py-0.5 font-mono text-[11px] font-bold uppercase tracking-wider text-[#00f0ff]">
                          <span class="h-1.5 w-1.5 rounded-full bg-[#00f0ff] animate-pulse"></span>
                          {isFr ? 'En cours' : 'Current'}
                        </span>
                      )}
                    </div>

                    <h4 class="mt-2 font-display text-lg sm:text-xl font-bold text-white">
                      {item.title[locale]}
                    </h4>
                    <p class="font-mono text-xs sm:text-sm text-[#00f0ff] mt-0.5">
                      {item.org}
                    </p>
                  </div>

                  <div class="text-left sm:text-right font-mono text-xs text-slate-400">
                    <div class="text-[#fcee0a] font-semibold">{item.period[locale]}</div>
                    <div class="mt-0.5">{item.location[locale]}</div>
                  </div>
                </div>

                <p class="mt-3 text-sm sm:text-base leading-relaxed text-slate-300">
                  {item.description[locale]}
                </p>

                {item.bullets[locale].length > 0 && (
                  <ul class="mt-3 space-y-1.5 text-sm text-slate-300">
                    {item.bullets[locale].map((bullet) => (
                      <li class="flex items-start gap-2">
                        <span class="mt-1.5 h-1.5 w-1.5 shrink-0 bg-[#00f0ff]"></span>
                        <span>{bullet}</span>
                      </li>
                    ))}
                  </ul>
                )}

                {item.tags[locale].length > 0 && (
                  <div class="mt-4 flex flex-wrap gap-1.5">
                    {item.tags[locale].map((tag) => (
                      <span class="border border-slate-700/80 bg-[#07080f]/80 px-2 py-0.5 font-mono text-[11px] text-slate-300">
                        {tag}
                      </span>
                    ))}
                  </div>
                )}
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </div>
</section>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>('[data-timeline-filter]');
  const items = document.querySelectorAll<HTMLElement>('[data-timeline-item]');

  const activeClasses = ['border-[#00f0ff]', 'bg-[#00f0ff]/15', 'text-[#00f0ff]'];
  const inactiveClasses = ['border-slate-700', 'bg-[#0d101d]', 'text-slate-300'];

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const filter = tab.dataset.timelineFilter ?? 'all';

      tabs.forEach((btn) => {
        const isActive = btn === tab;
        btn.setAttribute('aria-selected', String(isActive));
        activeClasses.forEach((cls) => btn.classList.toggle(cls, isActive));
        inactiveClasses.forEach((cls) => btn.classList.toggle(cls, !isActive));
      });

      items.forEach((item) => {
        const itemType = item.dataset.type ?? '';
        const visible = filter === 'all' || itemType === filter;
        item.classList.toggle('hidden', !visible);
      });
    });
  });
</script>
