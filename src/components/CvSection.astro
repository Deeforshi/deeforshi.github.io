---
import { ui, type Locale } from '../i18n/ui';
import { siteConfig } from '../data/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = ui[locale].cv;
const isFr = locale === 'fr';
const highlights = siteConfig.cvHighlights[locale];
---

<section id="cv" class="relative py-20 border-t border-[#00f0ff]/10">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <!-- Section Heading -->
    <div class="mb-10 flex flex-col gap-2">
      <span class="font-mono text-xs uppercase tracking-[0.22em] text-[#00f0ff]">
        {t.tag}
      </span>
      <h2 class="font-display text-3xl sm:text-4xl font-bold tracking-tight text-white">
        {t.title}
      </h2>
      <p class="max-w-2xl text-sm sm:text-base text-slate-400">
        {t.subtitle}
      </p>
    </div>

    <!-- Horizontal Cyberpunk HUD Card -->
    <div class="clip-cyber relative overflow-hidden border border-[#00f0ff]/35 bg-[#0d101d]/95 p-6 sm:p-8 shadow-[0_0_28px_rgba(0,240,255,0.1)]">
      <!-- Corner HUD Brackets -->
      <span aria-hidden="true" class="pointer-events-none absolute top-2.5 left-2.5 h-4 w-4 border-t-2 border-l-2 border-[#00f0ff]"></span>
      <span aria-hidden="true" class="pointer-events-none absolute top-2.5 right-2.5 h-4 w-4 border-t-2 border-r-2 border-[#ff2a85]"></span>
      <span aria-hidden="true" class="pointer-events-none absolute bottom-2.5 left-2.5 h-4 w-4 border-b-2 border-l-2 border-[#ff2a85]"></span>
      <span aria-hidden="true" class="pointer-events-none absolute bottom-2.5 right-2.5 h-4 w-4 border-b-2 border-r-2 border-[#00f0ff]"></span>

      <!-- Top File Meta Bar -->
      <div class="mb-6 flex flex-wrap items-center justify-between gap-3 border-b border-[#00f0ff]/20 pb-4 font-mono text-xs">
        <div class="inline-flex items-center gap-2.5">
          <span class="clip-cyber-sm border border-[#fcee0a]/45 bg-[#fcee0a]/10 px-2.5 py-1 font-bold text-[#fcee0a]">
            PDF // HeddyBrun_CV.pdf
          </span>
          <span class="text-slate-400">{t.fileInfo}</span>
        </div>
        <span class="text-[#00f0ff]">{isFr ? 'CV.PDF // PRÊT' : 'CV.PDF // READY'}</span>
      </div>

      <!-- Content & Actions -->
      <div class="grid items-center gap-8 lg:grid-cols-12">
        <div class="space-y-4 lg:col-span-8">
          <h3 class="font-display text-lg font-bold tracking-wide text-white">
            {t.highlightsTitle}
          </h3>
          <ul class="space-y-2.5">
            {highlights.map((item) => (
              <li class="flex items-start gap-3 text-sm sm:text-base text-slate-300">
                <span
                  aria-hidden="true"
                  class="mt-2 h-1.5 w-1.5 shrink-0 bg-[#00f0ff] shadow-[0_0_8px_#00f0ff]"
                ></span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="flex flex-col gap-3.5 lg:col-span-4">
          <a
            href={siteConfig.cvPath}
            download="HeddyBrun_CV.pdf"
            class="clip-cyber-sm inline-flex items-center justify-center gap-2.5 bg-[#00f0ff] px-5 py-3.5 font-mono text-xs sm:text-sm font-bold uppercase tracking-wider text-[#07080f] shadow-[0_0_20px_rgba(0,240,255,0.35)] transition-all hover:bg-[#33f3ff] hover:shadow-[0_0_28px_rgba(0,240,255,0.6)]"
          >
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v12m0 0l-4-4m4 4l4-4M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2" />
            </svg>
            <span>{t.downloadBtn}</span>
          </a>

          <a
            href={siteConfig.cvPath}
            target="_blank"
            rel="noopener noreferrer"
            class="clip-cyber-sm inline-flex items-center justify-center gap-2.5 border border-[#ff2a85] bg-[#ff2a85]/10 px-5 py-3.5 font-mono text-xs sm:text-sm font-bold uppercase tracking-wider text-[#ff2a85] transition-all hover:bg-[#ff2a85] hover:text-white hover:shadow-[0_0_22px_rgba(255,42,133,0.45)]"
          >
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14 3h7v7m0-7L10 14M18 14v5a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h5" />
            </svg>
            <span>{t.previewBtn}</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
