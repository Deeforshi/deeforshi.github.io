---
import { ui, type Locale } from '../i18n/ui';
import { siteConfig } from '../data/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const heroText = ui[locale].hero;
const isFr = locale === 'fr';
---

<section id="home" class="relative py-16 sm:py-24 lg:py-28">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="grid items-center gap-12 lg:grid-cols-12">
      <!-- Left: Identity & CTAs -->
      <div class="lg:col-span-7 space-y-6">
        <!-- Terminal status badge -->
        <div class="inline-flex items-center gap-2.5 clip-cyber-sm border border-[#00f0ff]/40 bg-[#0d101d]/90 px-3.5 py-1.5 font-mono text-xs tracking-wider text-[#00f0ff]">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#00f0ff] opacity-75"></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-[#00f0ff]"></span>
          </span>
          <span class="font-bold text-[#fcee0a]">[SYS.ONLINE]</span>
          <span class="text-slate-300">{heroText.badge}</span>
        </div>

        <!-- Headline -->
        <div class="space-y-3">
          <p class="font-mono text-sm uppercase tracking-[0.2em] text-slate-400">
            &gt; {heroText.greeting}
          </p>
          <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-black tracking-tight text-white leading-[1.08]">
            <span class="hover-glitch inline-block text-glow-cyan">{siteConfig.name}</span>
            <span class="block mt-3 text-xl sm:text-2xl lg:text-3xl font-bold bg-gradient-to-r from-[#00f0ff] via-slate-100 to-[#ff2a85] bg-clip-text text-transparent">
              {heroText.role}
            </span>
          </h1>

          <p class="max-w-2xl text-base sm:text-lg leading-relaxed text-slate-300">
            {heroText.subtitle}
          </p>
        </div>

        <!-- CTAs -->
        <div class="flex flex-wrap items-center gap-3.5 pt-2">
          <a
            href="#projects"
            class="clip-cyber-sm inline-flex items-center gap-2 bg-[#00f0ff] px-5 py-3 font-mono text-xs sm:text-sm font-bold uppercase tracking-wider text-[#07080f] shadow-[0_0_20px_rgba(0,240,255,0.4)] transition-all hover:bg-[#33f3ff] hover:shadow-[0_0_28px_rgba(0,240,255,0.65)]"
          >
            <span>{heroText.ctaProjects}</span>
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6l6 6-6 6" />
            </svg>
          </a>

          <a
            href={siteConfig.cvPath}
            download
            class="clip-cyber-sm inline-flex items-center gap-2 border border-[#ff2a85] bg-[#ff2a85]/10 px-5 py-3 font-mono text-xs sm:text-sm font-bold uppercase tracking-wider text-[#ff2a85] transition-all hover:bg-[#ff2a85] hover:text-white hover:shadow-[0_0_22px_rgba(255,42,133,0.45)]"
          >
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v12m0 0l-4-4m4 4l4-4M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2" />
            </svg>
            <span>{heroText.ctaCv}</span>
          </a>

          <a
            href="#contact"
            class="clip-cyber-sm inline-flex items-center gap-2 border border-slate-700 bg-[#0d101d]/70 px-5 py-3 font-mono text-xs sm:text-sm font-semibold uppercase tracking-wider text-slate-300 transition-all hover:border-[#00f0ff]/60 hover:text-[#00f0ff]"
          >
            <span>{heroText.ctaContact}</span>
          </a>
        </div>
      </div>

      <!-- Right: Cyberpunk HUD Avatar Frame -->
      <div class="lg:col-span-5 flex justify-center lg:justify-end">
        <div class="relative w-full max-w-sm">
          <!-- Floating ambient glow -->
          <div aria-hidden="true" class="absolute -inset-4 rounded-2xl bg-gradient-to-tr from-[#00f0ff]/25 via-[#9d4edd]/20 to-[#ff2a85]/25 blur-2xl opacity-75"></div>

          <div class="clip-cyber relative border border-[#00f0ff]/40 bg-[#0d101d]/95 p-4 shadow-[0_0_30px_rgba(0,240,255,0.14)]">
            <!-- Corner HUD brackets -->
            <span aria-hidden="true" class="pointer-events-none absolute top-2 left-2 h-4 w-4 border-t-2 border-l-2 border-[#00f0ff]"></span>
            <span aria-hidden="true" class="pointer-events-none absolute top-2 right-2 h-4 w-4 border-t-2 border-r-2 border-[#ff2a85]"></span>
            <span aria-hidden="true" class="pointer-events-none absolute bottom-2 left-2 h-4 w-4 border-b-2 border-l-2 border-[#ff2a85]"></span>
            <span aria-hidden="true" class="pointer-events-none absolute bottom-2 right-2 h-4 w-4 border-b-2 border-r-2 border-[#00f0ff]"></span>

            <!-- HUD Header Bar -->
            <div class="mb-3 flex items-center justify-between border-b border-[#00f0ff]/20 pb-2 font-mono text-[11px] tracking-wider">
              <span class="text-[#00f0ff]">ID // HEDDY.BRUN</span>
              <span class="text-[#fcee0a]">{isFr ? 'EN LIGNE' : 'ONLINE'}</span>
            </div>

            <!-- Avatar Image: Circular Cyberpunk Biometric Reticle -->
            <div class="relative flex flex-col items-center justify-center py-4 px-2">
              <div class="relative flex h-56 w-56 sm:h-60 sm:w-60 items-center justify-center">
                <!-- Outer dashed cyan ring -->
                <div aria-hidden="true" class="pointer-events-none absolute inset-0 rounded-full border border-dashed border-[#00f0ff]/45 animate-[spin_28s_linear_infinite]"></div>
                <!-- Inner magenta arc ring -->
                <div aria-hidden="true" class="pointer-events-none absolute inset-2 rounded-full border-2 border-transparent border-t-[#ff2a85]/80 border-b-[#00f0ff]/80 animate-[spin_16s_linear_infinite_reverse]"></div>
                <!-- Subtle radial glow behind portrait -->
                <div aria-hidden="true" class="pointer-events-none absolute inset-4 rounded-full bg-[#00f0ff]/15 blur-xl"></div>
                <!-- Circular portrait -->
                <div class="relative h-48 w-48 sm:h-52 sm:w-52 overflow-hidden rounded-full border-2 border-[#00f0ff]/60 bg-[#12172a] shadow-[0_0_25px_rgba(0,240,255,0.28)]">
                  <img
                    src={siteConfig.avatarPath}
                    alt={siteConfig.name}
                    width="480"
                    height="480"
                    loading="eager"
                    class="h-full w-full scale-[1.06] object-cover object-center transition-transform duration-500 hover:scale-[1.12]"
                  />
                  <div aria-hidden="true" class="pointer-events-none absolute inset-0 rounded-full ring-1 ring-inset ring-white/15 bg-gradient-to-t from-[#07080f]/45 via-transparent to-[#00f0ff]/10"></div>
                </div>
              </div>

              <div class="mt-4 flex w-full items-center justify-between font-mono text-[10px] tracking-widest text-slate-200 bg-[#07080f]/80 border border-[#00f0ff]/30 px-2.5 py-1 backdrop-blur-sm">
                <span class="text-[#00f0ff]">@{siteConfig.handle.toUpperCase()}</span>
                <span class="text-[#ff2a85]">{isFr ? 'ACTIF' : 'ACTIVE'}</span>
              </div>
            </div>

            <!-- Telemetry Tags -->
            <div class="mt-3 space-y-1.5 font-mono text-[11px] tracking-wider">
              <div class="flex items-center justify-between bg-[#12172a]/90 border border-slate-800 px-2.5 py-1.5">
                <span class="text-slate-400">{heroText.locationLabel}</span>
                <span class="text-[#00f0ff] font-semibold">BORDEAUX</span>
              </div>
              <div class="flex items-center justify-between bg-[#12172a]/90 border border-slate-800 px-2.5 py-1.5">
                <span class="text-slate-400">{heroText.statusLabel}</span>
                <span class="text-[#fcee0a] font-semibold">MAALSI 2026-2028</span>
              </div>
              <div class="flex items-center justify-between bg-[#12172a]/90 border border-slate-800 px-2.5 py-1.5">
                <span class="text-slate-400">STACK</span>
                <span class="text-[#ff2a85] font-semibold">DATA / AI / N8N</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
