---
import { ui, type Locale } from '../i18n/ui';
import { siteConfig } from '../data/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = ui[locale].contact;
const isFr = locale === 'fr';
const isConfigured = siteConfig.web3formsKey.trim().length > 0;
---

<section id="contact" class="relative py-20 border-t border-[#00f0ff]/10">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <!-- Section Heading -->
    <div class="mb-12 flex flex-col gap-2">
      <span class="font-mono text-xs uppercase tracking-[0.22em] text-[#00f0ff]">
        {t.tag}
      </span>
      <h2 class="font-display text-3xl sm:text-4xl font-bold tracking-tight text-white">
        {t.title}
      </h2>
      <p class="max-w-2xl text-sm sm:text-base text-slate-400">
        {t.subtitle}
      </p>
    </div>

    <div class="grid grid-cols-1 gap-8 lg:grid-cols-12">
      <!-- Left: Direct Channels HUD Cards -->
      <div class="space-y-4 lg:col-span-5">
        <h3 class="font-mono text-xs font-bold uppercase tracking-[0.2em] text-slate-400">
          // {t.directTitle}
        </h3>

        <!-- Email Card -->
        <a
          href={`mailto:${siteConfig.email}`}
          class="group clip-cyber-sm flex items-center gap-4 border border-[#00f0ff]/25 bg-[#0d101d]/90 p-4 transition-all hover:border-[#00f0ff]/75 hover:bg-[#12172a]"
        >
          <span class="clip-cyber-sm flex h-11 w-11 shrink-0 items-center justify-center border border-[#00f0ff]/40 bg-[#00f0ff]/10 text-[#00f0ff]">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 7a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="m3 7 9 6 9-6" />
            </svg>
          </span>
          <div class="min-w-0">
            <p class="font-mono text-[11px] uppercase tracking-wider text-slate-400">E-MAIL</p>
            <p class="truncate font-mono text-sm font-semibold text-white transition-colors group-hover:text-[#00f0ff]">
              {siteConfig.email}
            </p>
          </div>
        </a>

        <!-- Phone Card -->
        <a
          href={siteConfig.phoneHref}
          class="group clip-cyber-sm flex items-center gap-4 border border-[#ff2a85]/25 bg-[#0d101d]/90 p-4 transition-all hover:border-[#ff2a85]/75 hover:bg-[#12172a]"
        >
          <span class="clip-cyber-sm flex h-11 w-11 shrink-0 items-center justify-center border border-[#ff2a85]/40 bg-[#ff2a85]/10 text-[#ff2a85]">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" />
            </svg>
          </span>
          <div class="min-w-0">
            <p class="font-mono text-[11px] uppercase tracking-wider text-slate-400">{isFr ? 'TÉLÉPHONE' : 'PHONE'}</p>
            <p class="truncate font-mono text-sm font-semibold text-white transition-colors group-hover:text-[#ff2a85]">
              {siteConfig.phone}
            </p>
          </div>
        </a>

        <!-- Social Row: LinkedIn & GitHub -->
        <div class="grid grid-cols-2 gap-4">
          <a
            href={siteConfig.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="group clip-cyber-sm flex items-center gap-3 border border-[#00f0ff]/25 bg-[#0d101d]/90 p-4 transition-all hover:border-[#00f0ff]/75 hover:bg-[#12172a]"
          >
            <span class="flex h-9 w-9 shrink-0 items-center justify-center border border-[#00f0ff]/35 bg-[#00f0ff]/10 text-[#00f0ff]">
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z" />
              </svg>
            </span>
            <span class="font-mono text-xs font-bold uppercase tracking-wider text-slate-200 group-hover:text-[#00f0ff]">
              LinkedIn
            </span>
          </a>

          <a
            href={siteConfig.github}
            target="_blank"
            rel="noopener noreferrer"
            class="group clip-cyber-sm flex items-center gap-3 border border-[#00f0ff]/25 bg-[#0d101d]/90 p-4 transition-all hover:border-[#00f0ff]/75 hover:bg-[#12172a]"
          >
            <span class="flex h-9 w-9 shrink-0 items-center justify-center border border-[#00f0ff]/35 bg-[#00f0ff]/10 text-[#00f0ff]">
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path
                  fill-rule="evenodd"
                  clip-rule="evenodd"
                  d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
                />
              </svg>
            </span>
            <span class="font-mono text-xs font-bold uppercase tracking-wider text-slate-200 group-hover:text-[#00f0ff]">
              GitHub
            </span>
          </a>
        </div>

        <!-- Bordeaux Location Badge -->
        <div class="clip-cyber-sm flex items-center gap-4 border border-[#fcee0a]/30 bg-[#0d101d]/90 p-4">
          <span class="clip-cyber-sm flex h-11 w-11 shrink-0 items-center justify-center border border-[#fcee0a]/40 bg-[#fcee0a]/10 text-[#fcee0a]">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 21s-7-5.686-7-11a7 7 0 1 1 14 0c0 5.314-7 11-7 11z" />
              <circle cx="12" cy="10" r="2.5" />
            </svg>
          </span>
          <div>
            <p class="font-mono text-[11px] uppercase tracking-wider text-slate-400">{isFr ? 'LOCALISATION' : 'LOCATION'}</p>
            <p class="text-sm font-semibold text-white">{siteConfig.location[locale]}</p>
            <p class="font-mono text-xs text-[#fcee0a]">{siteConfig.drivingLicense[locale]}</p>
          </div>
        </div>
      </div>

      <!-- Right: Web3Forms Contact Form -->
      <div class="lg:col-span-7">
        <div class="clip-cyber border border-[#00f0ff]/30 bg-[#0d101d]/95 p-6 sm:p-8">
          <div class="mb-6 flex items-center justify-between border-b border-slate-800 pb-3">
            <h3 class="font-display text-lg font-bold text-white">{t.formTitle}</h3>
            <span class="font-mono text-[11px] uppercase tracking-wider text-[#00f0ff]">
              {isConfigured
                ? (isFr ? 'FORMULAIRE // EN LIGNE' : 'FORM // ONLINE')
                : (isFr ? 'CONTACT // DIRECT' : 'CONTACT // DIRECT')}
            </span>
          </div>

          <form
            id="contact-form"
            action="https://api.web3forms.com/submit"
            method="POST"
            class="space-y-4"
            data-web3forms-key={siteConfig.web3formsKey}
            data-fallback-email={siteConfig.email}
            data-send-label={t.sendBtn}
            data-sending-label={t.sendingBtn}
            data-success-msg={t.successMsg}
            data-error-msg={t.errorMsg}
            data-unconfigured-msg={t.unconfiguredHint}
          >
            <input type="hidden" name="access_key" value={siteConfig.web3formsKey} />
            <input
              type="checkbox"
              name="botcheck"
              class="hidden"
              style="display: none;"
              tabindex="-1"
              autocomplete="off"
            />

            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
              <div>
                <label for="contact-name" class="mb-1.5 block font-mono text-xs uppercase tracking-wider text-slate-300">
                  {t.nameLabel}
                </label>
                <input
                  id="contact-name"
                  name="name"
                  type="text"
                  required
                  placeholder={t.namePlaceholder}
                  class="clip-cyber-sm w-full border border-slate-700 bg-[#12172a] px-3.5 py-2.5 text-sm text-white placeholder-slate-500 transition-colors focus:border-[#00f0ff] focus:outline-none"
                />
              </div>

              <div>
                <label for="contact-email" class="mb-1.5 block font-mono text-xs uppercase tracking-wider text-slate-300">
                  {t.emailLabel}
                </label>
                <input
                  id="contact-email"
                  name="email"
                  type="email"
                  required
                  placeholder={t.emailPlaceholder}
                  class="clip-cyber-sm w-full border border-slate-700 bg-[#12172a] px-3.5 py-2.5 text-sm text-white placeholder-slate-500 transition-colors focus:border-[#00f0ff] focus:outline-none"
                />
              </div>
            </div>

            <div>
              <label for="contact-subject" class="mb-1.5 block font-mono text-xs uppercase tracking-wider text-slate-300">
                {t.subjectLabel}
              </label>
              <input
                id="contact-subject"
                name="subject"
                type="text"
                required
                placeholder={t.subjectPlaceholder}
                class="clip-cyber-sm w-full border border-slate-700 bg-[#12172a] px-3.5 py-2.5 text-sm text-white placeholder-slate-500 transition-colors focus:border-[#00f0ff] focus:outline-none"
              />
            </div>

            <div>
              <label for="contact-message" class="mb-1.5 block font-mono text-xs uppercase tracking-wider text-slate-300">
                {t.messageLabel}
              </label>
              <textarea
                id="contact-message"
                name="message"
                rows="4"
                required
                placeholder={t.messagePlaceholder}
                class="clip-cyber-sm w-full resize-y border border-slate-700 bg-[#12172a] px-3.5 py-2.5 text-sm text-white placeholder-slate-500 transition-colors focus:border-[#00f0ff] focus:outline-none"
              ></textarea>
            </div>

            {!isConfigured && (
              <p class="clip-cyber-sm border border-[#fcee0a]/30 bg-[#fcee0a]/5 px-3.5 py-2.5 font-mono text-xs text-[#fcee0a]">
                {t.unconfiguredHint}
              </p>
            )}

            <div class="pt-1">
              <button
                id="contact-submit"
                type="submit"
                class="clip-cyber-sm inline-flex w-full cursor-pointer items-center justify-center gap-2 bg-[#00f0ff] px-6 py-3 font-mono text-xs sm:text-sm font-bold uppercase tracking-wider text-[#07080f] shadow-[0_0_20px_rgba(0,240,255,0.35)] transition-all hover:bg-[#33f3ff] hover:shadow-[0_0_28px_rgba(0,240,255,0.6)] disabled:cursor-not-allowed disabled:opacity-60 sm:w-auto"
              >
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M22 2 11 13M22 2l-7 20-4-9-9-4 20-7z" />
                </svg>
                <span id="contact-submit-text">{t.sendBtn}</span>
              </button>
            </div>

            <div
              id="contact-status"
              role="status"
              aria-live="polite"
              class="hidden clip-cyber-sm border px-4 py-3 font-mono text-xs"
            ></div>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const submitBtn = document.getElementById('contact-submit') as HTMLButtonElement | null;
  const submitText = document.getElementById('contact-submit-text');
  const statusEl = document.getElementById('contact-status');

  const showStatus = (message: string, variant: 'success' | 'error' | 'info') => {
    if (!statusEl) return;
    statusEl.textContent = message;
    statusEl.classList.remove(
      'hidden',
      'border-[#00f0ff]/60',
      'bg-[#00f0ff]/10',
      'text-[#00f0ff]',
      'border-[#ff2a85]/60',
      'bg-[#ff2a85]/10',
      'text-[#ff2a85]',
      'border-[#fcee0a]/60',
      'bg-[#fcee0a]/10',
      'text-[#fcee0a]'
    );

    if (variant === 'success') {
      statusEl.classList.add('border-[#00f0ff]/60', 'bg-[#00f0ff]/10', 'text-[#00f0ff]');
    } else if (variant === 'error') {
      statusEl.classList.add('border-[#ff2a85]/60', 'bg-[#ff2a85]/10', 'text-[#ff2a85]');
    } else {
      statusEl.classList.add('border-[#fcee0a]/60', 'bg-[#fcee0a]/10', 'text-[#fcee0a]');
    }
  };

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form) return;

    const key = (form.dataset.web3formsKey ?? '').trim();
    const fallbackEmail = form.dataset.fallbackEmail ?? '';
    const sendLabel = form.dataset.sendLabel ?? 'Send';
    const sendingLabel = form.dataset.sendingLabel ?? 'Sending...';
    const successMsg = form.dataset.successMsg ?? 'Sent';
    const errorMsg = form.dataset.errorMsg ?? 'Error';
    const unconfiguredMsg = form.dataset.unconfiguredMsg ?? '';

    const formData = new FormData(form);
    if (formData.get('botcheck')) return;

    const name = String(formData.get('name') ?? '').trim();
    const email = String(formData.get('email') ?? '').trim();
    const subject = String(formData.get('subject') ?? '').trim();
    const message = String(formData.get('message') ?? '').trim();

    if (!key) {
      const body = `${message}\n\n---\n${name} (${email})`;
      const mailtoUrl = `mailto:${encodeURIComponent(fallbackEmail)}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      window.location.href = mailtoUrl;
      showStatus(unconfiguredMsg, 'info');
      return;
    }

    if (submitBtn) submitBtn.disabled = true;
    if (submitText) submitText.textContent = sendingLabel;

    try {
      const response = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          Accept: 'application/json',
        },
        body: JSON.stringify({
          access_key: key,
          name,
          email,
          subject,
          message,
        }),
      });

      const result = await response.json();
      if (response.ok && result.success) {
        showStatus(successMsg, 'success');
        form.reset();
      } else {
        showStatus(errorMsg, 'error');
      }
    } catch {
      showStatus(errorMsg, 'error');
    } finally {
      if (submitBtn) submitBtn.disabled = false;
      if (submitText) submitText.textContent = sendLabel;
    }
  });
</script>
